# Custom ScrollView styling
<ScrollView>:
    bar_color: 0.102, 0.451, 0.91, 0.7
    bar_inactive_color: 0.118, 0.227, 0.373, 0.5
    bar_width: "8dp"
    bar_margin: "3dp"
    scroll_type: ['bars', 'content']
